dataset_path: amalia-llm/bigbenchhard-mt-pt
output_type: generate_until
test_split: train
doc_to_target: "{{target}}"
metric_list:
- metric: exact_match
  aggregation: mean
  higher_is_better: true
    # ignore_case: true
    # ignore_punctuation: true
generation_kwargs:
  until:
  - "</s>"
  - <|endoftext|>
  - <|im_end|>
  - 'P:'
  do_sample: false
  temperature: 0.0
num_fewshot: 3
metadata:
  version: 2.0
