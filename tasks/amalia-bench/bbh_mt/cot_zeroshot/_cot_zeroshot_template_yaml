dataset_path: amalia-llm/bigbenchhard-mt-pt
output_type: generate_until
test_split: train
doc_to_target: "{{target}}"
metric_list:
- metric: exact_match
  aggregation: mean
  higher_is_better: true
  ignore_case: true
    # ignore_punctuation: true
  regexes_to_ignore:
  - "\\.$"
  - ","
  - "\\\\"
  - "\n"
  - '"'
generation_kwargs:
  until:
  - "</s>"
  - "<|im_end|>"
  - <|endoftext|>
  do_sample: false
  temperature: 0.0
num_fewshot: 0
metadata:
  version: 3.0
