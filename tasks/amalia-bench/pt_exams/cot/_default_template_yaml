dataset_path: amalia-llm/pt_exams
dataset_name: null
test_split: test
output_type: generate_until
doc_to_text: "Pergunta:\n{{question.strip()}}\nOpções:\n(A) {{choices[0]}}\n(B) {{choices[1]}}\n(C) {{choices[2]}}\n(D) {{choices[3]}}\n\nEscolha a opção correta para a pergunta acima. Apresente o seu raciocínio antes de responder. No final, apresente a sua resposta no formato \\boxed{X}, onde X é a letra da opção correta (A, B, C ou D)."
doc_to_target: "{{['A', 'B', 'C', 'D'][answer]}}"
generation_kwargs:
  until:
  - "</s>"
  - "<|im_end|>"
  - "<|endoftext|>"
  # - "\\boxed{A}"
  # - "\\boxed{B}"
  # - "\\boxed{C}"
  # - "\\boxed{D}"
  # - "\\boxed{X}"
  do_sample: false
  temperature: 0.0
  max_gen_toks: 2048
num_fewshot: 0
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
    ignore_punctuation: true
    ignore_case: true
filter_list:
- name: "pt-exams-answer-extractor"
  filter:
  - function: !function utils.ExtractAnswerR
  - function: "take_first"
metadata:
  version: 1.0
