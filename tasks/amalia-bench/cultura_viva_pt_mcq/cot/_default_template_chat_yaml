dataset_path: amalia-llm/cultura-viva-pt-mcq
output_type: generate_until
test_split: train
fewshot_split: train
fewshot_delimiter: "\n\n"
num_fewshot: 0
doc_to_text: "Pergunta:\n{{question.strip()}}\nOpções:\n(A) {{choices.text[0]}}\n(B) {{choices.text[1]}}\n(C) {{choices.text[2]}}\n(D) {{choices.text[3]}}\n\nEscolha a opção correta para a pergunta acima. Apresente o seu raciocínio antes de responder. No final, apresente a sua resposta no formato \\boxed{X}, onde X é a letra da opção correta (A, B, C ou D)."
doc_to_target: "{{ 'ABCD'[answerKey|int - 1] if answerKey|string in '1234' else answerKey }}"
generation_kwargs:
  max_gen_toks: 2048
  until:
  - "</s>"
  - "<|im_end|>"
  - "<|endoftext|>"
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
    ignore_punctuation: true
    ignore_case: true
filter_list:
- name: "pt-exams-answer-extractor"
  filter:
  - function: !function utils.ExtractAnswerR
  - function: "take_first"
metadata:
  version: 1.0