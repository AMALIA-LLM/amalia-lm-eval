dataset_path: amalia-llm/cultura-viva-pt-mcq
output_type: generate_until
test_split: train
fewshot_split: train
fewshot_delimiter: "\n\n"
num_fewshot: 0
doc_to_text: 'Dada a seguinte pergunta e quatro respostas candidatas (A, B, C e D), escolha a melhor resposta.\nPergunta: {{question.strip()}}\nA. {{choices.text[0]}}\nB. {{choices.text[1]}}\nC. {{choices.text[2]}}{% if choices.text|length > 3 %}\nD. {{choices.text[3]}}{% endif %}\nA sua resposta deve terminar com "A melhor resposta é [letra_da_resposta]" onde [letra_da_resposta] é A, B, C ou D.'
gen_prefix: 'A melhor resposta é'
doc_to_target: "{{ 'ABCD'[answerKey|int - 1] if answerKey|string in '1234' else answerKey }}"
generation_kwargs:
  max_gen_toks: 100
  until:
    - "\n\n"
    - "."
    - "</s>"
    - "<|im_end|>"
    - "<|endoftext|>"
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
    ignore_case: true
    ignore_punctuation: true
filter_list:
  - name: remove_whitespace
    filter:
      - function: remove_whitespace
      - function: take_first
metadata:
  version: 1.0