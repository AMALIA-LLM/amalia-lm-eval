dataset_path: NOVA-vision-language/calame-pt
dataset_name: null
test_split: train
output_type: generate_until
doc_to_text: "{{sentence.strip()}}"
doc_to_target: "{{last_word.strip()}}"
generation_kwargs:
  until:
  - "</s>"
  - "<|im_end|>"
  - "<|endoftext|>"
  do_sample: false
  temperature: 0.0
  max_gen_toks: 5
num_fewshot: 0
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
    ignore_punctuation: true
    ignore_case: true
filter_list:
- name: "get-answer"
  filter:
  - function: !function utils.ExtractAnswerR
  - function: "take_first"
metadata:
  version: 1.0
