# Environment configuration for running evaluation scripts
ACTIVATE_ENV="/path_to_env/py312_amalia/bin/activate"
HF_CACHE_REMOTE="/path_to_hf_cache/.cache"
DEFAULT_EVAL_OUTPUT_DIR="path_to_default_output_dir/eval_outputs"

# Special case for human eval in marenostrum which gets stuck when loading hf_evaluate.load("code_eval")
CODE_EVAL_FILE_PATH="path_to_hf_module_with_the_code_eval_file/code_eval.py"


# Environment configuration for REMOTE streamlit app (OPTIONAL) for HPC automatic updates:
REMOTE_USER_STREAMLIT="your_remote_user"
REMOTE_HOST_STREAMLIT="your_remote_host"
REMOTE_DIR_STREAMLIT="/remote/path/to/streamlit_app"
LOCAL_DIR_STREAMLIT="/local/path/to/streamlit_app"
